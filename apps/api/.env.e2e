# E2E test overrides. The e2e suite truncates all tables between tests,
# so NEVER point DATABASE_URL at a database with data you care about.
# This MUST stay pointed at the throwaway local database — especially now
# that the root .env points at Neon (loaded first, then overridden here).
DATABASE_URL=postgresql://secretforge:secretforge@localhost:5432/secretforge_test
DIRECT_URL=postgresql://secretforge:secretforge@localhost:5432/secretforge_test
