# ── Database ────────────────────────────────────────────────────────────────
# Local dev (matches docker-compose.yml):
DATABASE_URL=postgresql://secretforge:secretforge@localhost:5432/secretforge

# ── Master key (envelope encryption) ────────────────────────────────────────
# 32 bytes, base64-encoded. Generate with:  openssl rand -base64 32
# NEVER commit the real value. Back it up separately — losing it loses ALL secrets.
SECRETFORGE_MASTER_KEY=

# ── API ─────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# JWT signing secret. Generate with:  openssl rand -hex 32
JWT_SECRET=

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── Web UI (Phase 5) ────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
WEB_ORIGIN=http://localhost:3000
