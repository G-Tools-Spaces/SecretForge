# ── Database ────────────────────────────────────────────────────────────────
# Local dev (matches docker-compose.yml):
DATABASE_URL=postgresql://secretforge:secretforge@localhost:5432/secretforge

# ── Master key (envelope encryption) ────────────────────────────────────────
# 32 bytes, base64-encoded. Generate with:  openssl rand -base64 32
# NEVER commit the real value. Back it up separately — losing it loses ALL secrets.
SECRETFORGE_MASTER_KEY=

# ── API ─────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# JWT signing secret. Generate with:  openssl rand -hex 32
JWT_SECRET=

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── Web UI (Phase 5) ────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
WEB_ORIGIN=http://localhost:3000

# ── Social sign-in (optional) ───────────────────────────────────────────────
# Public base URL of the API — used to build OAuth redirect URIs.
# Through the Next.js dev proxy you can use the web origin instead.
API_PUBLIC_URL=http://localhost:4000

# Google: Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web). Authorized redirect URI: $API_PUBLIC_URL/auth/google/callback
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# GitHub: Settings → Developer settings → OAuth Apps → New OAuth App.
# Authorization callback URL: $API_PUBLIC_URL/auth/github/callback
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
