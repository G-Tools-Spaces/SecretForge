{
  "name": "@gtools-spaces/cli",
  "version": "0.1.5",
  "description": "forge — the SecretForge CLI. Fetch and inject secrets into your apps; no more .env files.",
  "license": "MIT",
  "keywords": [
    "secrets",
    "secrets-manager",
    "env-vars",
    "dotenv",
    "vault",
    "secretforge",
    "cli"
  ],
  "homepage": "https://github.com/G-Tools-Spaces/SecretForge#readme",
  "bugs": "https://github.com/G-Tools-Spaces/SecretForge/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/G-Tools-Spaces/SecretForge.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "forge": "dist/index.js",
    "secretforge": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "jest --silent"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    },
    "testEnvironment": "node"
  }
}
